# --- App ---
APP_ENV=development
APP_SECRET_KEY=change-me

# --- Postgres (Supabase) ---
# Direct / psql connections: host db.<ref>.supabase.co. For a pooled connection
# use host aws-0-<region>.pooler.supabase.com instead.
# DATABASE_URL=postgresql://postgres.<project-ref>:<DB_PASSWORD>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@database:5432/afcommerce

# --- Supabase (frontend) ---
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Elasticsearch ---
# Full URL wins; HOST/PORT below are only the compose-fallback.
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=products
# Elastic Cloud users: set ELASTICSEARCH_URL to the deployment endpoint and add
# ELASTICSEARCH_API_KEY=<your api key>.
# ELASTICSEARCH_HOST=elasticsearch
# ELASTICSEARCH_PORT=9200

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Dagster ---
DAGSTER_HOME=/opt/dagster/dagster_home
DAGSTER_PG_DB=dagster
DAGSTER_PG_USER=postgres
DAGSTER_PG_PASSWORD=postgres

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Scraper (Summerhill / Homesome API) ---
# Public API key + base URL used by the Summerhill storefront itself.
HOMESOME_API_BASE_URL=https://user-api.gethomesome.com
HOMESOME_API_KEY=13FEA88E-F12E-412D-937B-92860F79411A
# Optional per-store pricing. Unset to use the default catalog prices.
# HOMESOME_LOCATION=49AD2BB1-8187-466F-AC11-727D566EA2F3
# HOMESOME_PRICELIST=50AD507C-80F4-4B14-AD6F-6C149A29F2A0
SCRAPER_CURRENCY=CAD
SCRAPER_MAX_RETRIES=4
SCRAPER_RETRY_BASE_DELAY_MS=1000

# --- Communications ---
SMTP_HOST=localhost
SMTP_PORT=1025